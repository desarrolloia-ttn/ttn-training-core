# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.

# OpenAI (asistente, generación de lecciones y evaluaciones)
OPENAI_API_KEY=sk-...

# Asistente
ASSISTANT_MODEL=gpt-4o
ASSISTANT_MAX_TOKENS=1024

# Generación de lecciones / evaluaciones
# gpt-4o-mini tiene TPM alto y es barato (recomendado con cuota baja).
LESSON_MODEL=gpt-4o-mini
LESSON_MAX_TOKENS=6000
QUIZ_NUM_QUESTIONS=10
QUIZ_PASSING_SCORE=80

# Binarios externos (opcional; vacío = autodetección por PATH y rutas conocidas)
# PDFTOTEXT_PATH=
# FFMPEG_PATH=

# Orígenes del SPA permitidos por CORS (JSON list).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
